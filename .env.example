PORT=3000
HOST=127.0.0.1
SITE_URL=https://zaliv-retreat.ru
EMAIL_TO=vi-kate@mail.ru
# SMTP credentials from the mailbox provider. Use an application password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Create the bot using @BotFather, then put its token here (never in Git).
TELEGRAM_BOT_TOKEN=
# Send /id to your bot to find your private chat id.
TELEGRAM_ADMIN_CHAT_ID=
BOT_ENABLED=true
MAX_BOT_TOKEN=
# Personal dialog chat_id from /id in the MAX bot; it is not the Telegram ID.
MAX_ADMIN_CHAT_ID=
MAX_ENABLED=true
# Optional PEM CA bundle used only for MAX requests. TLS checks stay enabled.
MAX_CA_FILE=
DATA_DIR=./data
# Set only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
